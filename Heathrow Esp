local Players = game:GetService("Players")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

local HealthEsp = true  -- toggle this variable
local espObjects = {}
local lastData = {}

-- Pre-create drawing objects for each player
local function setupESP(player)
    if espObjects[player] then return end
    local esp = {
        Background = Drawing.new("Square"),
        Fill = Drawing.new("Square"),
        Text = Drawing.new("Text")
    }
    esp.Background.Thickness = 1
    esp.Background.Color = Color3.fromRGB(0, 0, 0)
    esp.Background.Filled = false
    esp.Background.Transparency = 0.5

    esp.Fill.Filled = true
    esp.Fill.Transparency = 0.6

    esp.Text.Size = 14
    esp.Text.Center = true
    esp.Text.Outline = true
    esp.Text.OutlineColor = Color3.fromRGB(0, 0, 0)
    esp.Text.Color = Color3.fromRGB(255, 255, 255)

    espObjects[player] = esp
    lastData[player] = { health = -1, pos = Vector3.new() }
end

local function removeESP(player)
    local esp = espObjects[player]
    if esp then
        esp.Background:Remove()
        esp.Fill:Remove()
        esp.Text:Remove()
        espObjects[player] = nil
        lastData[player] = nil
    end
end

-- Setup existing players
for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then setupESP(plr) end
end

Players.PlayerAdded:Connect(setupESP)
Players.PlayerRemoving:Connect(removeESP)

-- Main loop: runs fast only when active, sleeps when disabled
task.spawn(function()
    while true do
        if HealthEsp then
            -- Active: update every 0.03s (smooth but lightweight)
            for player, esp in pairs(espObjects) do
                if player == LocalPlayer then continue end
                local character = player.Character
                if not character then
                    esp.Background.Visible = false
                    esp.Fill.Visible = false
                    esp.Text.Visible = false
                    continue
                end

                local humanoid = character:FindFirstChild("Humanoid")
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                if not humanoid or not rootPart then
                    esp.Background.Visible = false
                    esp.Fill.Visible = false
                    esp.Text.Visible = false
                    continue
                end

                local health = humanoid.Health
                local maxHealth = humanoid.MaxHealth
                local healthPercent = math.clamp(health / maxHealth, 0, 1)
                local rootPos = rootPart.Position
                local last = lastData[player]

                -- Skip update if nothing changed (tiny thresholds for smoothness)
                local posChanged = (rootPos - last.pos).Magnitude > 0.1
                local healthChanged = math.abs(health - last.health) > 0.01

                if not posChanged and not healthChanged then
                    -- Keep visible, but no redraw
                    esp.Background.Visible = true
                    esp.Fill.Visible = true
                    esp.Text.Visible = true
                    continue
                end

                -- Update stored data
                last.pos = rootPos
                last.health = health

                -- World to screen
                local screenPos, onScreen = Camera:WorldToViewportPoint(rootPos + Vector3.new(0, 3, 0))
                if not onScreen then
                    esp.Background.Visible = false
                    esp.Fill.Visible = false
                    esp.Text.Visible = false
                    continue
                end

                local width = 100
                local height = 8
                local x = screenPos.X - width/2
                local y = screenPos.Y

                -- Background
                esp.Background.Position = Vector2.new(x, y)
                esp.Background.Size = Vector2.new(width, height)
                esp.Background.Visible = true

                -- Fill bar
                local fillWidth = width * healthPercent
                esp.Fill.Position = Vector2.new(x, y)
                esp.Fill.Size = Vector2.new(fillWidth, height)
                esp.Fill.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                esp.Fill.Visible = true

                -- Text (only update string if health changed)
                if healthChanged then
                    esp.Text.Text = string.format("%s - %d/%d", player.Name, math.floor(health), math.floor(maxHealth))
                end
                esp.Text.Position = Vector2.new(screenPos.X, y - 20)
                esp.Text.Visible = true
            end

            task.wait(0.03)  -- smooth refresh rate
        else
            -- Disabled: hide everything and sleep longer (save CPU)
            for _, esp in pairs(espObjects) do
                esp.Background.Visible = false
                esp.Fill.Visible = false
                esp.Text.Visible = false
            end
            task.wait(0.5)  -- check again after half a second
        end
    end
end)

print("Health ESP loaded. Toggle with: HealthEsp = false/true")
