local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

local AimbotEnabled = true
local AimKey = "RMB"  -- Right mouse button, change to "LMB", "Q", etc.
local AimFOV = 150    -- Max distance in pixels from crosshair to target
local Smoothness = 0.3 -- 0 = instant, 1 = very smooth
local AimPart = "Head" -- "Head", "HumanoidRootPart", "UpperTorso"

local target = nil
local isAiming = false

-- Get valid target (closest to crosshair within FOV)
local function getTarget()
    local closest = nil
    local closestDist = AimFOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character then continue end
        if player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health <= 0 then continue end

        local part = player.Character:FindFirstChild(AimPart)
        if not part then
            part = player.Character:FindFirstChild("HumanoidRootPart")
            if not part then continue end
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = player
        end
    end

    return closest
end

-- Smoothly move mouse to target
local function aimAt(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local part = targetPlayer.Character:FindFirstChild(AimPart)
    if not part then
        part = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not part then return end
    end

    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return end

    local currentPos = Vector2.new(Mouse.X, Mouse.Y)
    local targetPos = Vector2.new(screenPos.X, screenPos.Y)
    local delta = targetPos - currentPos

    if Smoothness > 0 then
        Mouse.Move(delta.X * Smoothness, delta.Y * Smoothness)
    else
        Mouse.Move(delta.X, delta.Y)
    end
end

-- Main loop
task.spawn(function()
    while true do
        if AimbotEnabled then
            -- Check if aim key is held
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and AimKey == "LMB" or
               UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) and AimKey == "RMB" or
               UserInputService:IsKeyDown(Enum.KeyCode[aimKey]) and AimKey ~= "LMB" and AimKey ~= "RMB" then
                
                isAiming = true
                target = getTarget()
                if target then
                    aimAt(target)
                end
            else
                isAiming = false
                target = nil
            end
        end
        task.wait(0.01) -- Fast loop for responsive aiming
    end
end)

